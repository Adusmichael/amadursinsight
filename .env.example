# Copy to .env.local and fill in. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Defaults to claude-opus-5. Set claude-sonnet-5 for a faster,
# cheaper run on this extraction task.
ANTHROPIC_MODEL="claude-opus-5"

# Only needed if your API key is identity-linked to an org workspace
# (the API returns "anthropic-workspace-id is required" without it).
# Find it in the Anthropic console under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=""
