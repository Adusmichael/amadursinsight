{
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "userStories", "acceptanceCriteria", "risks", "assumptions", "openQuestions"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. R1" },
          "kind": { "type": "string", "enum": ["functional", "non-functional", "business-rule", "constraint"] },
          "text": { "type": "string", "description": "one clear, testable statement" }
        }
      }
    },
    "userStories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "derivedFrom", "asA", "iWant", "soThat", "priority"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. US1" },
          "derivedFrom": { "type": "string", "description": "id of the functional requirement this story implements" },
          "asA": { "type": "string", "description": "the role with its article, e.g. 'a referral coordinator', without the leading 'As'" },
          "iWant": { "type": "string", "description": "the goal, without the leading 'I want'" },
          "soThat": { "type": "string", "description": "the benefit, without the leading 'so that'" },
          "priority": { "type": "string", "enum": ["unset", "must", "should", "could", "wont"] }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "storyId", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. AC1.1" },
          "storyId": { "type": "string", "description": "id of the user story this verifies" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. RSK1" },
          "text": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. ASM1" },
          "text": { "type": "string" }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "description": "short id, e.g. OQ1" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
